<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_task_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp" android:background="@drawable/planner_widget_row_background">
    <ImageButton android:id="@+id/widget_task_tick" android:layout_width="48dp" android:layout_height="48dp" android:padding="10dp" android:src="@drawable/ic_widget_unchecked" android:background="@android:color/transparent" android:contentDescription="Hoàn thành công việc" />
    <LinearLayout android:id="@+id/widget_task_body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
        <TextView android:id="@+id/widget_task_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#164e63" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_task_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#64748b" android:paddingTop="4dp" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_task_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#64748b" android:paddingTop="5dp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
