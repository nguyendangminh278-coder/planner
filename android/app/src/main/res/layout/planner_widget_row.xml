<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="@drawable/planner_widget_row_background">
    <TextView android:id="@+id/widget_row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:textColor="#164e63" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/widget_row_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#64748b" android:paddingTop="3dp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
