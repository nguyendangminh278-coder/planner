rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(data) { return signedIn() && data.ownerId == request.auth.uid; }
    function validRecurrence(rule) {
      return rule == null || (rule is map
        && rule.keys().hasAll(['frequency', 'interval', 'weekdays', 'monthlyMode', 'endType', 'untilDate', 'count'])
        && rule.keys().hasOnly(['frequency', 'interval', 'weekdays', 'monthlyMode', 'endType', 'untilDate', 'count'])
        && rule.frequency in ['daily', 'weekly', 'monthly', 'yearly']
        && rule.interval is int && rule.interval >= 1 && rule.interval <= 99
        && rule.weekdays is list && rule.weekdays.size() <= 7 && rule.weekdays.hasOnly([1,2,3,4,5,6,7])
        && (rule.frequency != 'weekly' || rule.weekdays.size() > 0)
        && rule.monthlyMode in ['date', 'weekday']
        && ((rule.endType == 'never' && rule.untilDate == null && rule.count == null)
          || (rule.endType == 'until' && rule.untilDate is string && rule.untilDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && rule.count == null)
          || (rule.endType == 'count' && rule.count is int && rule.count >= 1 && rule.count <= 1000 && rule.untilDate == null)));
    }
    function validEvent(data) {
      return data.keys().hasAll(['ownerId', 'title', 'start', 'end', 'color'])
        && data.keys().hasOnly(['ownerId', 'owner', 'title', 'start', 'end', 'color', 'createdAt', 'updatedAt', 'allDay', 'timeZone', 'recurrence'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.start is string && data.end is string && data.start < data.end
        && data.color is string
        && (!('allDay' in data) || data.allDay is bool)
        && (!('timeZone' in data) || (data.timeZone is string && data.timeZone.size() > 0 && data.timeZone.size() <= 100))
        && (!('recurrence' in data) || validRecurrence(data.recurrence))
        && (!(('recurrence' in data && data.recurrence != null) || ('allDay' in data && data.allDay)) || 'timeZone' in data);
    }
    function validTask(data) {
      return data.keys().hasAll(['ownerId', 'title', 'start', 'end', 'progress', 'details', 'steps', 'color'])
        && data.keys().hasOnly(['ownerId', 'owner', 'title', 'start', 'end', 'progress', 'details', 'steps', 'color', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.start is string && data.end is string && data.start <= data.end
        && data.progress is number && data.progress >= 0 && data.progress <= 100
        && data.details is string && data.details.size() <= 20000
        && data.steps is list && data.steps.size() <= 30 && data.color is string;
    }
    function sharedWithMe(ownerId) {
      return signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/calendarShares/$(ownerId)/viewers/$(request.auth.token.email.lower()));
    }
    match /events/{eventId} {
      allow read: if owns(resource.data) || sharedWithMe(resource.data.ownerId);
      allow create: if owns(request.resource.data) && validEvent(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data) && validEvent(request.resource.data);
      allow delete: if owns(resource.data);
    }
    match /tasks/{taskId} {
      allow read: if owns(resource.data) || sharedWithMe(resource.data.ownerId);
      allow delete: if owns(resource.data);
      allow create: if owns(request.resource.data) && validTask(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data) && validTask(request.resource.data);
    }
    match /moodEntries/{entryId} {
      function validMood(data) {
        return data.keys().hasAll(['ownerId', 'date', 'moodId', 'note', 'updatedAt'])
          && data.keys().hasOnly(['ownerId', 'date', 'moodId', 'note', 'updatedAt'])
          && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.moodId in ['sunny', 'cloudy', 'rainy', 'storm', 'rainbow', 'fog']
          && data.note is string && data.note.size() <= 4000
          && data.updatedAt == request.time
          && entryId == request.auth.uid + '_' + data.date;
      }
      allow read, delete: if owns(resource.data);
      allow create: if owns(request.resource.data) && validMood(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data) && validMood(request.resource.data);
    }
    match /calendarShares/{ownerId}/viewers/{email} {
      allow read: if signedIn() && request.auth.uid == ownerId;
      allow create, update: if signedIn() && request.auth.uid == ownerId
        && request.resource.data.keys().hasOnly(['ownerId', 'ownerName', 'viewerEmail', 'permission', 'createdAt'])
        && request.resource.data.ownerId == ownerId
        && request.resource.data.viewerEmail == email
        && email == email.lower() && email.size() <= 254
        && request.resource.data.permission == 'read';
      allow delete: if signedIn() && request.auth.uid == ownerId;
    }
    // Enables only queries constrained to the verified viewer's own email.
    match /{path=**}/viewers/{email} {
      allow read: if signedIn() && request.auth.token.email_verified == true
        && resource.data.viewerEmail == request.auth.token.email.lower();
    }
    match /profiles/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);
    }
  }
}
